# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
SUPABASE_URL=https://xxxx.supabase.co

# Project Settings → API → anon public
SUPABASE_ANON_KEY=eyJxxx...

# Project Settings → API → service_role secret  (NUNCA expongas esta clave en el frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dominio(s) permitidos, separados por coma (deja vacío en desarrollo local).
# Sin wildcard: un origen que no esté en esta lista es rechazado por el navegador.
# Ejemplo: https://effi-etiquetas.vercel.app,https://tu-dominio-custom.com
ALLOWED_ORIGIN=
